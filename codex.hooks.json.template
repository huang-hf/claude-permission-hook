{
  "hooks": {
    "PermissionRequest": [
      {
        "matcher": "^Bash$",
        "hooks": [
          {
            "type": "command",
            "command": "<PYTHON_WITH_DIPPY> \"$HOME/.claude/hooks/secure_handler.py\" --agent codex",
            "timeout": 30,
            "statusMessage": "Checking command with shared permission policy"
          }
        ]
      }
    ]
  }
}
